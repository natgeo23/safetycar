# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: fijar un modelo (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-3.8-flash
# Modelo de respaldo si el principal está saturado (por defecto gemini-flash-lite-latest)
# GEMINI_MODEL_RESPALDO=

# PIN compartido del taller para entrar a la app (obligatorio en producción)
APP_PIN=
# Cadena aleatoria larga para firmar la cookie de sesión
AUTH_SECRET=
