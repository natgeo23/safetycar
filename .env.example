# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: fijar un modelo (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-3.8-flash
# Modelo de respaldo si el principal está saturado (por defecto gemini-flash-lite-latest)
# GEMINI_MODEL_RESPALDO=

# PIN compartido del taller para entrar a la app (obligatorio en producción)
APP_PIN=
# Cadena aleatoria larga para firmar la cookie de sesión
AUTH_SECRET=

# Bot de WhatsApp (Evolution API)
EVOLUTION_URL=https://waba.mattanga.app
EVOLUTION_INSTANCE=safetycar
# Token de la instancia (no la clave global del servidor)
EVOLUTION_API_KEY=
# Lo manda Evolution en el header x-webhook-token
WHATSAPP_WEBHOOK_TOKEN=
# apagado | prueba (solo BOT_NUMEROS_PRUEBA) | activo
BOT_MODO=prueba
BOT_NUMEROS_PRUEBA=
# A quién avisar de turnos, presupuestos y derivaciones (coma)
BOT_AVISOS_A=

# Nombre con el que se presenta el bot si le preguntan (opcional)
# BOT_NOMBRE=
