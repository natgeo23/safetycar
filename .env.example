# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: cambiar el modelo de visión
# ANTHROPIC_MODEL=claude-opus-5-5

# PIN compartido del taller para entrar a la app (si se deja vacío, la app queda abierta)
APP_PIN=
# Cadena aleatoria larga para firmar la cookie de sesión
AUTH_SECRET=
